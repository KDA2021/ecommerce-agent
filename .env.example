# OpenAI 兼容网关
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# MySQL（业务数据 + checkpointer）
DATABASE_URL=mysql+asyncmy://ecommerce:ecommerce@localhost:3307/ecommerce?charset=utf8mb4

# Chroma 本地目录
CHROMA_DIR=data/chroma

# Tavily WebSearch（留空则不注册 web_search_tool）
TAVILY_API_KEY=

# 本地 Reranker（BGE CrossEncoder）
RERANKER_ENABLED=1
RERANKER_MODEL=BAAI/bge-reranker-base

# 上下文压缩
CONTEXT_TRIGGER_TOKENS=6000
CONTEXT_KEEP_RECENT=8

# 语义缓存
SEMANTIC_CACHE_THRESHOLD=0.05
SEMANTIC_CACHE_BUCKET_LIMIT=30

# A/B 实验开关（P10-5，Dashboard 会展示当前取值）
# 语义缓存总开关：1=开启（默认），0=关闭；关闭后 /commerce/intents 直接跑 Agent
SEMANTIC_CACHE_ENABLED=1
# 模型路由模式：llm=planner LLM 派发子 Agent（默认）；direct=跳过 planner，由主 Agent 自己决策工具
MODEL_ROUTE_MODE=llm

# 成本估算单价（USD / 1K tokens，可选；缺省 0.002）
LLM_PRICE_PER_1K_TOKENS=0.002

# 偏好记忆
PREFERENCE_TOP_K=5

# 工具韧性（P4）
# 30s：容纳冷 CPU 精排首次加载/推理，同时保持熔断仍有意义
TOOL_TIMEOUT_SECONDS=30
TOOL_FAILURE_THRESHOLD=3
TOOL_CIRCUIT_RESET_SECONDS=60.0

# LLM 重试与并发闸门（P4）
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=2.0
LLM_MAX_CONCURRENCY=2

# 子 Agent 容错（P8-3）：deadline / 显式失败重试上限 / 任务租约
SUBAGENT_TIMEOUT_SECONDS=120
SUBAGENT_MAX_RETRIES=2
SUBAGENT_LEASE_SECONDS=180

# trade 串行链（P12-1）：单次请求最多执行几个 trade 子任务；非正数表示不额外限制
TRADE_CHAIN_MAX_STEPS=5

# Redis（P9，可选）：留空则缓存/限流/幂等全部关闭，行为与 P8 一致
REDIS_URL=

# 滑动窗口限流（P9-3，可选；Redis 未启用/故障时自动 fail-open 放行）
# 软阈值：窗口内计数超过它只返回 Retry-After 提示；突发硬上限：超过返回 429
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=60
# 限流维度：buyer（买家，缺省）或 ip（客户端 IP）
RATE_LIMIT_SCOPE=buyer

# 下单确认握手（P10-2 修复）
# create_order 发布 order.preview 后真实挂起等待买家确认的最长秒数；
# 超时按取消处理、绝不落库。前端 POST /commerce/orders/confirm 会立即唤醒等待。
ORDER_CONFIRM_TIMEOUT_SECONDS=120

# API Key 鉴权（P11-3，可选）
# 留空 = 不鉴权（本地开发默认，向后兼容）。
# 配置后 /commerce/* 必须带 X-API-Key 请求头或 ?api_key= 查询参数，否则 401；
# /health 与 /docs 始终开放。
API_KEY=

# 多 worker 队列与广播（P11-4，可选）
# direct（默认）= /commerce/intents 请求内直接跑 Agent，行为与 P11-3 完全一致。
# redis = /commerce/intents 只把任务写进 Redis Stream 并立刻返回 task_id，
#   由 `scripts/agent_worker.py` 消费；SSE 事件通过 Redis Pub/Sub 广播到所有实例。
#   redis 模式依赖 REDIS_URL，请同时配置它。
QUEUE_MODE=direct
QUEUE_STREAM_KEY=ecommerce:intents
QUEUE_GROUP=ecommerce-workers
# worker pending 重投的空闲阈值（秒）：超过该时间没 ack 的任务会被 XAUTOCLAIM 重投
QUEUE_CLAIM_IDLE_SECONDS=60

# 结构化日志（P15-3）
# json（默认）= 单行 JSON：ts/level/logger/msg + 可选 request_id/trace_id（供采集器解析）。
# text = 人类可读单行（本地直连终端排障用，不用先过 jq）。
LOG_FORMAT=json
# 日志级别：DEBUG / INFO（默认）/ WARNING / ERROR / CRITICAL；非法值回落 INFO。
LOG_LEVEL=INFO
